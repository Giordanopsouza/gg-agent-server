# Copy to /etc/gg/runtime.env with mode 0600.

GG_RUNTIME_API_KEY=rotate-me
GG_RUNTIME_HOST=127.0.0.1
GG_RUNTIME_PORT=8001
GG_TASK_DB_PATH=/var/lib/gg/tasks.sqlite
GG_DISPATCH_LOCK_PATH=/var/lib/gg/tasks.sqlite.dispatch.lock
GG_TASK_EVIDENCE_DIR=/var/lib/gg/evidence
GG_TASK_DISPATCH_ENABLED=true

GG_MODAL_APP_NAME=gg-agent-sandboxes
GG_MODAL_DEPLOYMENT=gg-production
GG_MODAL_IMAGE_NAME=gg-agent-server:2026-09-20-v1

GG_REPOSITORY_ALLOWLIST=your-org/your-repo
GG_REPOSITORY_PROFILES_PATH=/etc/gg/repository-profiles.json
GG_GITHUB_CLONE_TOKEN=
OPENROUTER_API_KEY=
